# 10_host_preflight.sh 가 2026-08-31T16:31:44+09:00 에 생성. 30_host_run.sh 가 읽는다.
# 값이 마음에 안 들면 여기서 직접 고치면 된다.
#
# ⚠ 2026-08-31 수기 정정: preflight 자동탐색(grep 'gpu0')이 우리 운영 컨테이너가
#   아니라 GPU01(2026-08-24 생성, choh/torch_2_3_1 이미지, /home/choh 바인드,
#   shm 64MB — 교수님 쪽 컨테이너)을 잡아 MOUNTS/PORTS 를 잘못 추출했었다.
#   그 MOUNTS 엔 /home/snorlax/shared 가 없어 새 컨테이너에서 repo 가 안 보였다.
#   아래 값은 RUNBOOK §1.3(운영 컨테이너 실측 바인드) 기준으로 손수 정정한 것.

# 정지 대상 옛 컨테이너 — GPU01 은 우리 것이 아니므로 절대 넣지 말 것.
# 실제 운영(구) 컨테이너명을 호스트에서 `docker ps -a` 로 확인해 채우면 30_host_run 이
# stop 해 주고, 비워두면 stop 단계를 건너뛴다(이미 수동으로 정리한 경우).
OLD_CTN=""
NEW_CTN="${NEW_CTN:-mri_gpu0}"
NEW_HOSTNAME="${NEW_HOSTNAME:-snorlax_WORK0}"
IMAGE="${IMAGE:-mri:v1}"

# 운영 컨테이너의 실제 바인드 (RUNBOOK §1.3): repo+ckpt 128G 가 있는 NVMe 와
# fastMRI 원본 tar 가 있는 HDD. /home/snorlax/shared 가 빠지면 repo 가 안 보인다.
MOUNTS="-v /home/snorlax/shared:/home/snorlax/shared -v /mnt/sda:/mnt/sda "
# 포트: 22203:22 는 GPU01 의 것이었다(뺏으면 그쪽 ssh 가 끊긴다). 우리 컨테이너에
# 호스트 ssh 포트가 필요하면 비어있지 않은 다른 포트로 직접 지정할 것 (예: 22204).
PORTS=""
WORKDIR="/home/snorlax/shared/fastmri_ViT_with_eternet"

# 네트워크 모드. host 모드면 --hostname/-p 를 쓸 수 없으므로 30_host_run.sh 가
# 자동으로 그 둘을 뺀다.
NETMODE="bridge"

# 자원 — 07-08 설정이 실제로 반영돼 있었음(shm 128G, memory.max 256GiB) → 유지
SHM_SIZE="128g"
MEM_LIMIT="256g"

# GPU 노출: 우리 TITAN RTX 한 장만. 교수님 GPU 는 노드 자체를 넣지 않으므로
# 컨테이너 안에서 존재조차 보이지 않는다(설정 실수로도 접근 불가).
#   · NVIDIA_VISIBLE_DEVICES  = UUID 고정 → 인덱스가 밀려도 다른 카드를 안 잡음
#   · --device                = 우리 카드 노드 + 공통 제어 노드만
#     이 --device 명시가 이번 재구성의 핵심이기도 하다 — 도커가 device cgroup
#     규칙을 직접 소유하게 되어 systemd 가 cgroup 을 재적용해도 규칙이 복원된다.
NVIDIA_VISIBLE="GPU-93881c1e-8244-c1c6-cbae-26c672d13400"
NV_DEVICES=" --device /dev/nvidiactl --device /dev/nvidia-uvm --device /dev/nvidia-uvm-tools --device /dev/nvidia-modeset --device /dev/nvidia0"
